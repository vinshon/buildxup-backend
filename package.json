{
  "name": "buildxup-backend",
  "version": "1.0.0",
  "description": "BuildXup Backend API",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "webpack",
    "build:sam": "sam build",
    "build:dist": "sam build && cp -r .aws-sam/build/*/ dist/",
    "build:watch": "webpack --watch",
    "start": "npm run build && nodemon --exec sam local start-api --port 4000",
    "dev": "nodemon index.js",
    "prisma:generate": "prisma generate",
    "prisma:all:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:validate": "npx prisma validate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.798.0",
    "@aws-sdk/client-sqs": "^3.798.0",
    "@prisma/client": "^5.13.0",
    "@sendgrid/mail": "^8.1.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "multer-s3": "^2.10.0",
    "pg": "^8.16.0",
    "serverless-http": "^3.2.0",
    "twilio": "^4.23.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "aws-sdk": "^2.1692.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^13.0.0",
    "nodemon": "^3.0.3",
    "prisma": "^5.13.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "main": "index.js"
}
